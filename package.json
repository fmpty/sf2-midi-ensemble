{
  "name": "sf2-midi-ensemble",
  "productName": "SF2 MIDI Ensemble",
  "version": "1.0.0",
  "description": "跨平台 SF2 音源合奏器：内置/加载 SoundFont，同时接入多个蓝牙 MIDI 手柄演奏多个乐器",
  "main": "src/main/main.js",
  "author": "SF2 MIDI Ensemble",
  "license": "LicenseRef-Sf2MidiEnsemble-NonCommercial-1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "start": "node scripts/build.js && electron .",
    "smoke": "node scripts/build.js && electron tools/smoke.js",
    "dist": "node scripts/build.js && node scripts/pre-electron-dist.js && node scripts/run-electron-builder.js && node scripts/clean-stale-win-dist.js",
    "mobile:sync": "node scripts/pre-android-build.js && node scripts/build.js && npx cap sync android && node scripts/verify-web-in-android.js && node scripts/sync-native.js",
    "mobile:android": "npm run mobile:sync && node scripts/build-android.js",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "web": "node scripts/build.js && node tools/serve.js",
    "web:serve": "node tools/serve.js",
    "web:https": "node scripts/build.js && node tools/serve.js --https --lan",
    "web:watch": "node scripts/build.js --watch"
  },
  "dependencies": {
    "@julusian/midi": "^3.6.1",
    "spessasynth_lib": "^4.4.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "generaluser": "^1.47.1"
  },
  "build": {
    "appId": "com.sf2.ensemble",
    "productName": "SF2 MIDI Ensemble",
    "icon": "assets/icon.ico",
    "files": [
      "src/main/**",
      "src/renderer/**",
      "assets/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/@julusian/midi/**",
      "node_modules/@julusian/rtmidi/**"
    ],
    "disableAsarIntegrity": true,
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "win": {
      "target": [
        { "target": "dir", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
